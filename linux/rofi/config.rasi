configuration {
    modi:               "drun,run,window";
    show-icons:         false;
    icon-theme:         "Papirus";
    display-drun:       "Apps";
    display-run:        "Run";
    display-window:     "Windows";
    drun-display-format: "{name}";
    font:               "JetBrainsMono Nerd Font 11";
    sidebar-mode:       false;
}

@theme "theme.rasi"

# Hard Mono palette for Ghostty.
# Brutalist black & white: pure black background, pure white text, inverted
# selection and a strictly greyscale ANSI palette. Colors are told apart by
# brightness only. Kept in sync with osx/sketchybar/themes/hard-mono.sh.

background = #000000
foreground = #ffffff
cursor-color = #ffffff
cursor-text = #000000
selection-background = #ffffff
selection-foreground = #000000
palette-generate = true

palette = 0=#000000
palette = 1=#bfbfbf
palette = 2=#d9d9d9
palette = 3=#e6e6e6
palette = 4=#a6a6a6
palette = 5=#b3b3b3
palette = 6=#cccccc
palette = 7=#f2f2f2
palette = 8=#666666
palette = 9=#d9d9d9
palette = 10=#ececec
palette = 11=#f5f5f5
palette = 12=#c0c0c0
palette = 13=#cccccc
palette = 14=#e0e0e0

#!/usr/bin/env bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
THEME_DIR="$CONFIG_DIR/themes"

##############################
#  Theme                      #
##############################
# All colors, fonts and spacing live in themes/*.sh so a new look can be
# applied by swapping the sourced file (or overriding $THEME).

THEME="${THEME:-noctalia}"
# shellcheck source=themes/noctalia.sh
source "$THEME_DIR/$THEME.sh"

##############################
#  Bar – three islands        #
##############################
# The bar itself is fully transparent. The visible surfaces are three
# rounded "islands" (bracket items) drawn behind each group:
#   left   = launcher
#   center = media + system monitors
#   right  = network, volume, clock, session, battery

sketchybar --bar position=top \
  height="$BAR_HEIGHT" \
  color="$COLOR_BAR_BG" \
  shadow=off \
  sticky=on \
  margin="$BAR_MARGIN" \
  padding_left="$BAR_PADDING_LEFT" \
  padding_right="$BAR_PADDING_RIGHT" \
  corner_radius="$BAR_CORNER_RADIUS" \
  border_width="$BAR_BORDER_WIDTH" \
  blur_radius="$BAR_BLUR_RADIUS" \
  y_offset="$BAR_Y_OFFSET"

################################
#  Global defaults             #
################################

default=(
  padding_left="$ITEM_PADDING_LEFT"
  padding_right="$ITEM_PADDING_RIGHT"

  icon.font="$FONT_ICON"
  label.font="$FONT_LABEL"

  icon.font.size="$FONT_SIZE_ICON"
  label.font.size="$FONT_SIZE_LABEL"

  icon.color="$COLOR_ICON"
  label.color="$COLOR_LABEL"

  icon.padding_left="$ICON_PADDING_LEFT"
  icon.padding_right="$ICON_PADDING_RIGHT"
  label.padding_left="$LABEL_PADDING_LEFT"
  label.padding_right="$LABEL_PADDING_RIGHT"

  background.drawing=off
  background.border_width=0
)

sketchybar --default "${default[@]}"

# Shared styling applied to every island bracket.
island=(
  background.drawing=on
  background.color="$COLOR_ISLAND_BG"
  background.border_color="$COLOR_ISLAND_BORDER"
  background.border_width="$ISLAND_BORDER_WIDTH"
  background.corner_radius="$ISLAND_CORNER_RADIUS"
  background.height="$ISLAND_HEIGHT"
  background.shadow.drawing="$ISLAND_SHADOW"
)

POPUP_SCRIPT="sketchybar -m --set \$NAME popup.drawing=toggle"

################################
#  ISLAND 1: Launcher + spaces  #
################################

sketchybar --add item launcher left \
  --set launcher icon=󰚌 \
  icon.font.size=20.0 \
  label.drawing=off

# AeroSpace workspace indicator. Unfocused workspaces are reduced to a plain
# dot; the focused one shows its name instead. Empty workspaces are hidden
# entirely (see SHOW_EMPTY_WORKSPACES in the theme). State is refreshed by
# plugins/aerospace.sh via the hidden spaces_watcher item below.

ISLAND_LEFT_MEMBERS=(launcher)

if command -v aerospace >/dev/null 2>&1; then
  while read -r ws; do
    [ -n "$ws" ] || continue

    # Items start hidden as dots; aerospace.sh reveals the occupied ones and
    # expands the focused one into its name. Starting hidden avoids a flash
    # of every workspace during startup.
    sketchybar --add item "space.$ws" left \
      --set "space.$ws" icon="$WORKSPACE_DOT_ICON" \
      drawing=off \
      icon.font.size="$WORKSPACE_DOT_FONT_SIZE" \
      icon.padding_left="$WORKSPACE_ICON_PADDING" \
      icon.padding_right="$WORKSPACE_ICON_PADDING" \
      padding_left="$WORKSPACE_ITEM_PADDING" \
      padding_right="$WORKSPACE_ITEM_PADDING" \
      label="$ws" \
      label.drawing=off \
      label.padding_left="$WORKSPACE_LABEL_PADDING" \
      label.padding_right="$WORKSPACE_LABEL_PADDING" \
      background.corner_radius="$WORKSPACE_CORNER_RADIUS" \
      background.height="$WORKSPACE_HEIGHT" \
      background.drawing=off \
      click_script="aerospace workspace $ws"

    ISLAND_LEFT_MEMBERS+=("space.$ws")
  done <<<"$(aerospace list-workspaces --all)"

  # Hidden driver item: refreshes every space.* item in one batch whenever
  # the focused workspace changes.
  #
  # `space_windows_change` is a native macOS Spaces event and never fires
  # under AeroSpace, so occupancy is kept fresh by the explicit triggers in
  # ~/.aerospace.toml plus a low-frequency poll as a safety net (covers apps
  # quitting in a background workspace, `aerospace` run from a shell, ...).
  sketchybar --add event aerospace_workspace_change \
    --add item spaces_watcher left \
    --set spaces_watcher drawing=off \
    updates=on \
    update_freq="$WORKSPACE_POLL_FREQ" \
    script="$PLUGIN_DIR/aerospace.sh" \
    --subscribe spaces_watcher aerospace_workspace_change front_app_switched \
    system_woke
fi

################################################
#  ISLAND 2: Media + system monitors            #
################################################
# When the display has a notch (NOTCH_SPACING=true), this island is placed in
# the left section instead, so it doesn't get hidden behind it.

CENTER_SECTION="center"
if [ "$NOTCH_SPACING" = "true" ]; then
  CENTER_SECTION="left"
fi

SPOTIFY_EVENT="com.spotify.client.PlaybackStateChanged"

sketchybar --add event spotify_change $SPOTIFY_EVENT \
  --add item spotify.name "$CENTER_SECTION" \
  --set spotify.name icon=󰓇 \
  icon.font.size=15.0 \
  label="Not Playing" \
  update_freq=5 \
  script="$PLUGIN_DIR/spotify.sh" \
  click_script="$POPUP_SCRIPT" \
  popup.horizontal=on \
  popup.align=center \
  popup.background.color="$COLOR_POPUP_BG" \
  popup.background.corner_radius="$POPUP_CORNER_RADIUS" \
  popup.background.border_width="$POPUP_BORDER_WIDTH" \
  popup.background.shadow.drawing=off \
  --subscribe spotify.name spotify_change system_woke

controls=("back:󰒮" "play:󰐊" "next:󰒭" "shuffle:󰒝" "repeat:󰑖")

for ctrl in "${controls[@]}"; do
  IFS=':' read -r name icon <<<"$ctrl"

  sketchybar --add item "spotify.$name" popup.spotify.name \
    --set "spotify.$name" icon="$icon" \
    icon.font.size=15.0 \
    label.drawing=off \
    updates=on \
    script="$PLUGIN_DIR/spotify.sh" \
    --subscribe "spotify.$name" mouse.clicked spotify_change
done

sketchybar --add item time "$CENTER_SECTION" \
  --set time update_freq=10 \
  icon= \
  script="$PLUGIN_DIR/clock.sh"

##################################################
#  ISLAND 3: Network, volume, clock, session, battery #
##################################################
# Items are added right-to-left, so the visual order on screen is the
# reverse of the order below: wifi, bluetooth, volume, clock, power, battery.

sketchybar --add item battery right \
  --set battery icon=󰁹 \
  update_freq=60 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item power right \
  --set power icon=󰐥 \
  label.drawing=off \
  click_script="$POPUP_SCRIPT" \
  popup.align=center \
  popup.background.color="$COLOR_POPUP_BG" \
  popup.background.corner_radius="$POPUP_CORNER_RADIUS" \
  popup.background.border_width="$POPUP_BORDER_WIDTH" \
  popup.background.shadow.drawing=off

power_actions=("lock:󰌾" "sleep:󰤄" "logout:󰍃" "reboot:󰑐" "shutdown:󰐥")

for action in "${power_actions[@]}"; do
  IFS=':' read -r name icon <<<"$action"

  sketchybar --add item "power.$name" popup.power \
    --set "power.$name" icon="$icon" \
    label="$name" \
    script="$PLUGIN_DIR/power.sh" \
    --subscribe "power.$name" mouse.clicked
done

sketchybar --add item volume right \
  --set volume icon=󰕾 \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item wifi right \
  --set wifi icon=󰤨 \
  update_freq=30 \
  script="$PLUGIN_DIR/wifi.sh" \
  click_script="open x-apple.systempreferences:com.apple.wifi-settings" \
  --subscribe wifi wifi_change

sketchybar --add item bluetooth right \
  --add event bluetooth_status "com.apple.bluetooth.status" \
  --set bluetooth icon=󰂯 \
  label.drawing=off \
  update_freq=30 \
  script="$PLUGIN_DIR/bluetooth.sh" \
  click_script="open x-apple.systempreferences:com.apple.preferences.Bluetooth" \
  --subscribe bluetooth bluetooth_status

################################
#  Island backgrounds           #
################################
# Brackets draw the rounded background behind each group of items. They must
# be added after their members exist.

sketchybar --add bracket island.left "${ISLAND_LEFT_MEMBERS[@]}" \
  --set island.left "${island[@]}"

sketchybar --add bracket island.center \
  spotify.name time \
  --set island.center "${island[@]}"

sketchybar --add bracket island.right \
  bluetooth wifi volume power battery \
  --set island.right "${island[@]}"

# Breathing room between the islands and the screen edges.
sketchybar --set launcher padding_left="$ISLAND_PADDING" \
  --set battery padding_right="$ISLAND_PADDING"

#################
#  Final launch #
#################

# Paint the initial workspace state (the event only fires on changes).
if command -v aerospace >/dev/null 2>&1; then
  "$PLUGIN_DIR/aerospace.sh"
fi

sketchybar --update
